{
  "buildCommand": "npm run build",
  "outputDirectory": "site",
  "installCommand": "npm run install:all",
  "framework": null,
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/classic/assets/:path*"
    },
    {
      "source": "/:path(home|onboarding|dashboard|upload|documents|chat|search)/:rest*",
      "destination": "/classic/index.html"
    },
    {
      "source": "/classic/:path*",
      "destination": "/classic/index.html"
    }
  ]
}
