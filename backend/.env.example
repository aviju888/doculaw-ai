# Server Configuration
PORT=3001

# Groq API (for LLM - document simplification and chat)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone (for vector search)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=legal-search

# Optional: existing filesystem storage root (default backend/data)
# DOCULAW_DATA_DIR=/path/to/persistent/doculaw-data
# Optional compatible Groq model overrides
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_DEEP_MODEL=openai/gpt-oss-120b
# Loopback default for local previews; set explicitly for your hosting environment
HOST=127.0.0.1
